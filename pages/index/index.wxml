<view class="container" wx:if="{{!finished}}">
  <view class="header">
    <text class="progress">第 {{currentIndex + 1}} / {{questions.length}} 题</text>
    <text class="score">得分：{{score}}</text>
  </view>

  <view class="card">
    <text class="question">{{questions[currentIndex].title}}</text>

    <view class="options">
      <view
        wx:for="{{questions[currentIndex].options}}"
        wx:key="index"
        class="option {{selectedOption === index ? 'selected' : ''}} {{checked && questions[currentIndex].answer === index ? 'correct' : ''}} {{checked && selectedOption === index && questions[currentIndex].answer !== index ? 'wrong' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectOption"
      >
        <text>{{index + 1}}. {{item}}</text>
      </view>
    </view>

    <view class="result" wx:if="{{checked}}">
      <text class="{{isCorrect ? 'ok' : 'fail'}}">
        {{isCorrect ? '回答正确' : '回答错误'}}
      </text>
      <text class="explanation">解析：{{questions[currentIndex].explanation}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn check" bindtap="onCheckAnswer">判题</button>
    <button class="btn next" bindtap="onNextQuestion">下一题</button>
  </view>
</view>

<view class="container" wx:else>
  <view class="card finish-card">
    <text class="finish-title">已完成全部题目</text>
    <text class="finish-score">最终得分：{{score}} / {{questions.length}}</text>
    <button class="btn restart" bindtap="onRestart">再刷一轮</button>
  </view>
</view>
